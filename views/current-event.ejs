        function calculateAndDisplayRoute(directionsService, directionsRenderer) {
            directionsService.route(
                {
                    origin: {query: start},
                    destination: {query: end},
                    travelMode: mode, //DRIVING, WALKING, BICYCLING, TRANSIT
                    provideRouteAlternatives: false,
                    /*drivingOptions: {
                        departureTime: dt
                    }*/
                },
                function(response, status) {
                    if (status === 'OK') {
                        //console.log(response)
                        document.getElementById('stats-box').style.display = "block";
                        var distance = response.routes[0].legs[0].distance.text; 
                        var time = response.routes[0].legs[0].duration;
                        var d=new Date();
                        var curTime = parseInt(d.getHours())*60+parseInt(d.getMinutes());
                        var dd = String(d.getDate()).padStart(2, '0');
                        var mm = String(d.getMonth() + 1).padStart(2, '0'); 
                        var yyyy = d.getFullYear();
                        today = yyyy + '-' + mm + '-' + dd; 
                        
                        //Departure Time calulation
                        var meetingStart=meetingStartTime.split(":");
                        var mins= parseInt(meetingStart[0])*60 + parseInt(meetingStart[1]);
                        mins=mins-parseInt(time.value/60);
                        var late=parseInt(curTime-mins);
                        if(mins<curTime&&meetingStartDate===today){
                            if(late<11){
                                console.log("you are "+late+" mins late for meeting");
                                let toast1 = `<div class="toast" id="minlate" role="alert" aria-live="assertive" aria-atomic="true">
                                                <div class="toast-header">
                                                    <strong class="mr-auto">Alert!!</strong>
                                                    <small class="text-muted">just now</small>
                                                    <button type="button" class="ml-2 mb-1 close" data-dismiss="toast" aria-label="Close">
                                                        <span aria-hidden="true">&times;</span>
                                                    </button>
                                                </div>
                                                <div class="toast-body">
                                                    You are ${late} mins late for meeting
                                                </div>
                                            </div>`;
                                document.getElementById('toast-container').innerHTML += toast1;
                                $("#minLate").toast('show');
                            }
                            
                            else if(curTime-mins>10){
                                console.log("you cannot reach at your meeting");
                                let toast2 = `<div class="toast" id="cannotReach" role="alert" aria-live="assertive" aria-atomic="true">
                                                <div class="toast-header">
                                                    <strong class="mr-auto">Alert!!</strong>
                                                    <small class="text-muted">just now</small>
                                                    <button type="button" class="ml-2 mb-1 close" data-dismiss="toast" aria-label="Close">
                                                        <span aria-hidden="true">&times;</span>
                                                    </button>
                                                </div>
                                                <div class="toast-body">
                                                    You cannot reach at your meeting
                                                </div>
                                            </div>`;
                                document.getElementById('toast-container').innerHTML += toast2;
                                $("#cannotReach").toast('show'); 
                            }
                        }
                        else{
                          var departureTime =parseInt(mins/60)+":"+((mins%60 < 10) ? ("0" + mins%60) : mins%60);
                          console.log(departureTime);
                          document.getElementById('departure-time').style.display = "block";
                          document.getElementById('departure-time').textContent = "You can depart at " + departureTime + " on " + meetingStartDate; 
                        }

                        //Calculate Free Time
                        if(meetingStartDate===today){
                            var freeTime =mins-curTime;
                            if(freeTime>0){
                                freeTime=parseInt(freeTime/60)+" hrs "+freeTime%60+" mins";
                                console.log(freeTime);
                                document.getElementById('free-time').style.display = "block";
                                document.getElementById('free-time').textContent = "You can spend " + freeTime + " before meeting" ;
                            }
                            /*else {
                                console.log("you are already late for your meeting");
                                let toast3 = `<div class="toast" id="alreadyLate" role="alert" aria-live="assertive" aria-atomic="true" data-delay="10000">
                                                <div class="toast-header">
                                                    <strong class="mr-auto">Alert!!</strong>
                                                    <small class="text-muted">just now</small>
                                                    <button type="button" class="ml-2 mb-1 close" data-dismiss="toast" aria-label="Close">
                                                        <span aria-hidden="true">&times;</span>
                                                    </button>
                                                </div>
                                                <div class="toast-body">
                                                    You are already late for meeting
                                                </div>
                                            </div>`;
                                document.getElementById('toast-container').innerHTML += toast3; 
                                $("#alreadyLate").toast('show'); 
                            }*/
                                
                        }
                        
                       
                        
                        document.getElementById('time').textContent = time.text; 
                        document.getElementById('distance').textContent = '(' + distance + ')'; 
                        directionsRenderer.setDirections(response);
                    } else {
                        if(status == "ZERO_RESULTS"){
                            //alert('No route found for this mode...')
                            document.getElementById('time').textContent = "No route found."; 
                            document.getElementById('distance').textContent = ""; 
                        }
                        //window.alert('Directions request failed due to ' + status);
                    }
                });
        }

        function getLocation(){
            if(navigator.geolocation){
                navigator.geolocation.getCurrentPosition(showPosition, showError);
            }
            else{
                alert("Geolocation is not supported here")
            }
        }

        function showPosition(position){
            //document.getElementById('start_location').value = "Your location";
            //console.log(position.coords.latitude, position.coords.longitude)
            var input = position.coords.latitude + "," + position.coords.longitude;
            var latlngStr = input.split(',', 2);
            var latlng = {lat: parseFloat(latlngStr[0]), lng: parseFloat(latlngStr[1])};
            //console.log(latlng)
            geocoder.geocode({'location': latlng}, function(results, status) {
                if (status === 'OK') {
                    if (results[0]) {
                        start = results[0].formatted_address;
                        //getting current event info 
                        axios.post(window.location)
                            .then(response =>{
                                if(response.data.success){
                                    meetingStartTime=response.data.event.meetingStartTime;
                                    meetingStartDate=response.data.event.meetingDate;
                                    end = response.data.event.location;

                                    //setting up see event details 
                                    document.getElementById('event-name').textContent = response.data.event.event;
                                    document.getElementById('event-date').textContent = response.data.event.meetingDate;
                                    document.getElementById('event-time').textContent = response.data.event.meetingStartTime + ' to ' + response.data.event.meetingEndTime;
                                    document.getElementById('event-location').textContent = response.data.event.location;

                                   
                                    calculateAndDisplayRoute(directionsService, directionsRenderer);
                                }
                                else{
                                    console.log(response.data.message)
                                }
                            })  
                            .catch(err =>{
                                console.log(err)
                            })
                         
                    } else {
                        window.alert('No results found');
                    }
                } else {
                    window.alert('Geocoder failed due to: ' + status);
                }
            });
        }

        function showError(error){
            switch(error.code){
                case error.PERMISSION_DENIED: 
                    console.log("User denied request for location")
                    break; 
                case error.POSITION_UNAVAILABLE: 
                    console.log("Location information is unavailable")
                    break; 
                case error.TIMEOUT: 
                    console.log("Request to get location timed out")
                    break; 
                case error.UNKNOWN_ERROR: 
                    console.log("Unknown error occurred")
                    break; 
            }
        }

        function changeMode(newMode){
            mode = newMode; 
            calculateAndDisplayRoute(directionsService, directionsRenderer);
        }

    </script>
</body>

