    <div class="modal fade p" tabindex="-1" id="changeOriginModal" role="dialog" aria-labelledby="changeOriginModal" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="changeOriginModalLabel">Change origin</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                      <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">    
                    <p>Type new start location to check new route.</p>
                    <div class="input-group mb-3">
                        <input type="text" class="form-control" id="new-origin" placeholder="Start location" aria-label="Start location" aria-describedby="basic-addon2">
                        <div class="input-group-append">
                            <button class="btn btn-outline-primary" type="button" onclick = "newOrigin()">Change</button>
                        </div>
                    </div>
                </div>    
            </div>
        </div>
    </div>

    <div class="modal fade p" tabindex="-1" id="changeTimeModal" role="dialog" aria-labelledby="changeTimeModal" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="changeTimeModalLabel">Change time / origin</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                      <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">    
                    <p>Enter just start time or both time and origin</p>
                    <input type="text" class="form-control my-2" id="new-start" placeholder="Start location" />
                    <input type="time" class="form-control my-2" id="new-time" />
                </div> 
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-danger" data-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" onclick="newOriginTime()">New route</button>
                </div>   
            </div>
        </div>
    </div>

    <div class="modal fade p" tabindex="-1" id="seeEventModal" role="dialog" aria-labelledby="seeEventModal" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
