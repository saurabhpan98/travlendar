<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
    <link rel="icon" type="image/png" href="/images/travlendar-icons-1.png"/>
    <title>Travlendar / Event</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.0/css/bootstrap.min.css" integrity="sha384-9aIt2nRpC12Uk9gS9baDl411NQApFmC26EwAOH8WgZl5MYYxFfc+NcPb1dKGj7Sk" crossorigin="anonymous">
    <link rel="stylesheet" href="/assets/fonts/material-icons.min.css">
    <link rel="stylesheet" href="/assets/css/Navigation-Clean.css">
    <link rel="stylesheet" href="/assets/css/styles.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/axios/0.19.2/axios.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400&display=swap" rel="stylesheet">
    <style>
        body{
            font-family: 'Roboto', sans-serif;
        }
        #map{
            height: 100vh;
            width: 100vw;
        }
        .stats-box{
            position: fixed; 
            bottom: 20px;
            left: 20px;
        }
        .modes .nav-link{
            border-radius: 10px;
            cursor: pointer;
            padding-top: 13px; 
        }
        #panel{
            position: fixed; 
            top: 30px;
            left: 30px;
        }
    </style>
</head>

<body>
    <nav class="navbar navbar-light navbar-expand-md shadow-sm">
        <div class="container-fluid">
            <a class="navbar-brand" href="/profile">
                <%= user.name %>
            </a>
            <button data-toggle="collapse" class="navbar-toggler" data-target="#navcol-1"><span class="sr-only">Toggle navigation</span><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse"
                id="navcol-1">
                <ul class="nav navbar-nav ml-auto">
                    <li class="nav-item px-2" role="presentation" href="#"><a class="nav-link" href="/">Home</a></li>
                    <li class="nav-item px-2" role="presentation" href="#"><a class="nav-link" href="/profile">Events</a></li>
                    <li class="nav-item px-2" role="presentation" href="#"><a class="nav-link" href="/settings">Settings</a></li>
                    <li class="nav-item px-2" role="presentation" href="#"><a class="nav-link" href="/logout">Logout</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <div id="map">

    </div>
    <!--<div id="panel" class="rounded shadow-sm">

    </div>-->

    <div class="stats-box rounded shadow-sm bg-primary pt-1">
        <div class="p-2 pt-3 bg-white">
            <div class="distance-time">
                <span class="time text-success lead" id="time"></span>
                <span class="distance lead" id="distance"></span>
            </div>
            <div class="modes mt-2">
                <ul class="nav nav-pills mb-2" id="pills-tab" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link active" id="pills-home-tab" data-toggle="pill" role="tab" aria-selective="true" onclick = "changeMode('DRIVING')">
                            <i class="material-icons d-block">directions_car</i>
                            <span>Drive</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" id="pills-home-tab" data-toggle="pill" role="tab" aria-selective="true" onclick = "changeMode('TRANSIT')">
                            <i class="material-icons d-block">directions_railway</i>
                            <span>Train or Bus</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" id="pills-home-tab" data-toggle="pill" role="tab" aria-selective="true" onclick = "changeMode('BICYCLING')">
                            <i class="material-icons d-block">directions_bike</i>
                            <span>Two-wheeler</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" id="pills-home-tab" data-toggle="pill" role="tab" aria-selective="true" onclick = "changeMode('WALKING')">
                            <i class="material-icons d-block">directions_run</i>
                            <span>Walk</span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.5.1.min.js" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.0/js/bootstrap.min.js" integrity="sha384-OgVRvuATP1z7JjHLkuOU7Xw704+h835Lr+6QL9UvYjZE3Ipu6Tp75j7Bh/kR0JKI" crossorigin="anonymous"></script>
    <script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyD4-QOWTvatTe_46i2XOI6tXUIx40hHVQY&callback=initMap" async defer></script>
    <script>
        var directionsRenderer, directionsService, start, end, geocoder, mode = "DRIVING";
        function initMap() {
            directionsService = new google.maps.DirectionsService();
            directionsRenderer = new google.maps.DirectionsRenderer({
                draggable: true
            });
            var mapOptions = {
                zoom:12,
                center: { lat: 28.624364, lng: 77.208289 }
            }
            var map = new google.maps.Map(document.getElementById('map'), mapOptions);
            directionsRenderer.setMap(map);
            //directionsRenderer.setPanel(document.getElementById('panel'));
            getLocation();
            geocoder = new google.maps.Geocoder;
        }

        function calculateAndDisplayRoute(directionsService, directionsRenderer) {
            directionsService.route(
                {
                    origin: {query: start},
                    destination: {query: end},
                    travelMode: mode, //DRIVING, WALKING, BICYCLING, TRANSIT
                    provideRouteAlternatives: false
                },
                function(response, status) {
                    if (status === 'OK') {
                        console.log(response)
                        var distance = response.routes[0].legs[0].distance.text; 
                        var time = response.routes[0].legs[0].duration.text;
                        document.getElementById('time').textContent = time; 
                        document.getElementById('distance').textContent = '(' + distance + ')'; 
                        directionsRenderer.setDirections(response);
                    } else {
                        if(status == "ZERO_RESULTS"){
                            //alert('No route found for this mode...')
                            document.getElementById('time').textContent = "No route found."; 
                            document.getElementById('distance').textContent = ""; 
                        }
                        //window.alert('Directions request failed due to ' + status);
                    }
                });
        }

        function getLocation(){
            if(navigator.geolocation){
                navigator.geolocation.getCurrentPosition(showPosition, showError);
            }
            else{
                alert("Geolocation is not supported here")
            }
        }

        function showPosition(position){
            //document.getElementById('start_location').value = "Your location";
            //console.log(position.coords.latitude, position.coords.longitude)
            var input = position.coords.latitude + "," + position.coords.longitude;
            var latlngStr = input.split(',', 2);
            var latlng = {lat: parseFloat(latlngStr[0]), lng: parseFloat(latlngStr[1])};
            //console.log(latlng)
            geocoder.geocode({'location': latlng}, function(results, status) {
                if (status === 'OK') {
                    if (results[0]) {
                        /*map.setZoom(11);
                        var marker = new google.maps.Marker({
                            position: latlng,
                            map: map    
                        });
                        infowindow.setContent(results[0].formatted_address);
                        infowindow.open(map, marker);*/
                        start = results[0].formatted_address;
                        calculateAndDisplayRoute(directionsService, directionsRenderer); 
                    } else {
                        window.alert('No results found');
                    }
                } else {
                    window.alert('Geocoder failed due to: ' + status);
                }
            });
        }

        function showError(error){
            switch(error.code){
                case error.PERMISSION_DENIED: 
                    console.log("User denied request for location")
                    break; 
                case error.POSITION_UNAVAILABLE: 
                    console.log("Location information is unavailable")
                    break; 
                case error.TIMEOUT: 
                    console.log("Request to get location timed out")
                    break; 
                case error.UNKNOWN_ERROR: 
                    console.log("Unknown error occurred")
                    break; 
            }
        }

        function changeMode(newMode){
            mode = newMode; 
            calculateAndDisplayRoute(directionsService, directionsRenderer);
        }

        //getting current event info 
        axios.post(window.location)
            .then(response =>{
                //console.log(response.data)
                if(response.data.success){
                    end = response.data.event.location;
                }
                else{
                    console.log(response.data.message)
                }
            })  
            .catch(err =>{
                console.log(err)
            })
    </script>
</body>

</html>