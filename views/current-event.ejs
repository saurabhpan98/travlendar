<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
    <link rel="icon" type="image/png" href="/images/logo-travel.png"/>
    <title>Travlendar / Event</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.0/css/bootstrap.min.css" integrity="sha384-9aIt2nRpC12Uk9gS9baDl411NQApFmC26EwAOH8WgZl5MYYxFfc+NcPb1dKGj7Sk" crossorigin="anonymous">
    <link rel="stylesheet" href="/assets/fonts/material-icons.min.css">
    <link rel="stylesheet" href="/assets/css/Navigation-Clean.css">
    <link rel="stylesheet" href="/assets/css/styles.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/axios/0.19.2/axios.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400&display=swap" rel="stylesheet">
    <style>
        body{
            font-family: 'Roboto', sans-serif;
        }
        #map{
            height: 100vh;
        }
        .stats-box{
            position: fixed;
            bottom: 20px;
            left: 20px;
        }
        .modes .nav-link{
            border-radius: 10px;
            cursor: pointer;
            padding-top: 13px;
        }
        #panelOut{
            position: fixed;
            top: 60px;
            left: 20px;
            max-width: 300px;
            max-height: 400px;
            overflow: hidden;
            overflow-y: auto;
            border-radius: 12px;
        }

        .pac-container{
            z-index: 99999;
        }
    </style>
</head>

<body>
    <nav class="navbar navbar-light navbar-expand-md shadow-sm">
        <div class="container-fluid">
            <a class="navbar-brand" href="/profile">
                <% if(user.thumbnail != ""){ %>
                    <img src = <%= user.thumbnail %> id="profilepic" width="30" height="30" class="d-inline-block align-top mr-1 rounded" />
                <% } %>
                <%= user.name %>
            </a>
            <button data-toggle="collapse" class="navbar-toggler" data-target="#navcol-1"><span class="sr-only">Toggle navigation</span><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse"
                id="navcol-1">
                <ul class="nav navbar-nav ml-auto">
                    <li class="nav-item px-2" role="presentation" href="#"><a class="nav-link" href="/">Home</a></li>
                    <li class="nav-item px-2" role="presentation" href="#"><a class="nav-link" href="/profile">Events</a></li>
                    <li class="nav-item px-2" role="presentation" href="#"><a class="nav-link" href="/settings">Settings</a></li>
                    <li class="nav-item px-2" role="presentation" href="#"><a class="nav-link" href="/logout">Logout</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <div id="map" class="container-fluid">

    </div>

    <div id="panelOut" class="p-2 bg-white shadow" style="display: none;">
        <div class="ml-2 mt-2 d-flex w-100">
            <h4 class="">Detailed route</h4>
            <a class="text-decoration-none" style="margin-right: 0; margin-left: auto;" href="#" onclick="closePanel()"><i class="material-icons">close</i></a>
        </div>
        <div id="panel">

        </div>
    </div>

    <div class="stats-box rounded shadow-sm bg-primary pt-1" id="stats-box" style="display: none";>
        <div class="p-2 pt-3 bg-white">
            <div class="distance-time">
                <span class="time text-success lead" id="time"></span>
                <span class="distance lead" id="distance"></span>

                <div class="float-right d-inline-flex" style="margin-bottom: -5px;">
                    <a href="#" class="text-decoration-none text-danger mr-2" data-toggle="modal" data-target="#weatherModal">
                        <i class="material-icons text-primary">filter_drama</i>
                    </a>
                    <div class="dropup">
                        <a class="text-decoration-none" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" href="#"><i class="material-icons">more_vert</i></a>
                        <div class="dropdown-menu">
                            <a class="dropdown-item" href="#" data-toggle="modal" data-target="#changeOriginModal">Change origin</a>
                            <a class="dropdown-item" href="#" onclick="showPanel()">Detailed route</a>
                            <a class="dropdown-item" href="#" onclick="seeEvent()">Event details</a>
                        </div>
                    </div>
                </div>

            </div>
            <span id="departure-time" class="d-block" style="display: none;"></span>
            <span id="free-time" class="d-block" style="display: none;"></span>
            <div class="modes mt-2" style="font-size: 12px;">
                <ul class="nav nav-pills mb-2" id="pills-tab" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link active" id="pills-home-tab" data-toggle="pill" role="tab" aria-selective="true" onclick = "changeMode('DRIVING')">
                            <i class="material-icons d-block">directions_car</i>
                            <span>Drive</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" id="pills-home-tab" data-toggle="pill" role="tab" aria-selective="true" onclick = "changeMode('TRANSIT')">
                            <i class="material-icons d-block">directions_railway</i>
                            <span>Train or Bus</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" id="pills-home-tab" data-toggle="pill" role="tab" aria-selective="true" onclick = "changeMode('BICYCLING')">
                            <i class="material-icons d-block">directions_bike</i>
                            <span>Two-wheeler</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" id="pills-home-tab" data-toggle="pill" role="tab" aria-selective="true" onclick = "changeMode('WALKING')">
                            <i class="material-icons d-block">directions_run</i>
                            <span>Walk</span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <div class="modal fade p" tabindex="-1" id="weatherModal" role="dialog" aria-labelledby="weatherModal" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title" id="weatherModalLabel">Weather</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                      <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body pb-3">
                    <div class="row">
                      <div class="col-6">
                        <span class="text-left font-weight-bold lead" id="weather-location"></span>
                      </div>
                      <div class="col-6 text-right">
                        <img alt="weather image" class="" id="weather-image">
                        <span id="weather-report"></span>
                      </div>
                    </div>
                    <span class="text-left" id="weather-date"></span>
                    <h1 id="weather-temp" class="text-center d-block mt-3"></h1>
                    <div class="row">
                      <div class="col-6 text-right" id="temp-min">

                      </div>
                      <div class="col-6 text-left" id="temp-max">

                      </div>
                    </div>

                    <div class="row mt-5 mb-5">
                      <div class="col-3 text-center" id="temp1"></div>
                      <div class="col-3 text-center" id="temp2"></div>
                      <div class="col-3 text-center" id="temp3"></div>
                      <div class="col-3 text-center" id="temp4"></div>
                    </div>

                    <small class="text-center d-block w-100 mt-2">Copyright &copy; 2020, Weather report by Travlendar</small>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade p" tabindex="-1" id="changeOriginModal" role="dialog" aria-labelledby="changeOriginModal" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="changeOriginModalLabel">Change origin</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                      <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <p>Type new start location to check new route.</p>
                    <div class="input-group mb-3">
                        <input type="text" class="form-control" id="new-origin" placeholder="Start location" aria-label="Start location" aria-describedby="basic-addon2">
                        <div class="input-group-append">
                            <button class="btn btn-outline-primary" type="button" onclick = "newOrigin()">Change</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade p" tabindex="-1" id="changeTimeModal" role="dialog" aria-labelledby="changeTimeModal" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="changeTimeModalLabel">Change time / origin</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                      <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <p>Enter just start time or both time and origin</p>
                    <input type="text" class="form-control my-2" id="new-start" placeholder="Start location" />
                    <input type="time" class="form-control my-2" id="new-time" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-danger" data-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" onclick="newOriginTime()">New route</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade p" tabindex="-1" id="seeEventModal" role="dialog" aria-labelledby="seeEventModal" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="seeEventModalLabel">Event details</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                      <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <h4 class="mb-3" id="event-name"></h4>
                    <span class="d-block"><strong>Meeting on:</strong> <span id="event-date"></span></span>
                    <span class="d-block"><strong>Meeting time:</strong> <span id="event-time"></span> </span>
                    <span class="d-block mt-3"><strong>Location:</strong> <span id="event-location"><span></span>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-danger" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <div id="toast-container" aria-live="polite" aria-atomic="true" style="position: fixed; top: 70px; right: 20px; min-width: 300px; min-height: 200px;">
        <div class="toast" id="cannotReach" role="alert" aria-live="assertive" aria-atomic="true" data-autohide="false">
            <div class="toast-header">
                <strong class="mr-auto">Alert!!</strong>
                <small class="text-muted">just now</small>
                <button type="button" class="ml-2 mb-1 close" data-dismiss="toast" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="toast-body">
                <span id="toast-message"></span>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.5.1.min.js" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.12.9/umd/popper.min.js" integrity="sha384-ApNbgh9B+Y1QKtv3Rn7W3mgPxhU9K/ScQsAP7hUibX39j7fakFPskvXusvfa0b4Q" crossorigin="anonymous"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.0/js/bootstrap.min.js" integrity="sha384-OgVRvuATP1z7JjHLkuOU7Xw704+h835Lr+6QL9UvYjZE3Ipu6Tp75j7Bh/kR0JKI" crossorigin="anonymous"></script>
    <script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyD4-QOWTvatTe_46i2XOI6tXUIx40hHVQY&libraries=places&callback=initMap" async defer></script>
    <script>

        var map, directionsRenderer, directionsService, dt = new Date(), start, end, geocoder, mode = "DRIVING",meetingStartTime, meetingStartDate,miniTime,shortestMode;
        function initMap() {
            directionsService = new google.maps.DirectionsService();
            directionsRenderer = new google.maps.DirectionsRenderer;
            var style=[];
            var today =new Date();
            var hours = parseInt(today.getHours());
            var minutes= parseInt(today.getMinutes()) ;
            if(hours>=0&&hours<=5)hours+=24;
            console.log(hours+ " " + minutes);
            if(hours>18||(hours===18 && minutes>=30)){
                style= [
                    {elementType: 'geometry', stylers: [{color: '#242f3e'}]},
                    {elementType: 'labels.text.stroke', stylers: [{color: '#242f3e'}]},
                    {elementType: 'labels.text.fill', stylers: [{color: '#746855'}]},
                    {
                        featureType: 'administrative.locality',
                        elementType: 'labels.text.fill',
                        stylers: [{color: '#d59563'}]
                    },
                    {
                        featureType: 'poi',
                        elementType: 'labels.text.fill',
                        stylers: [{color: '#d59563'}]
                    },
                    {
                        featureType: 'poi.park',
                        elementType: 'geometry',
                        stylers: [{color: '#263c3f'}]
                    },
                    {
                        featureType: 'poi.park',
                        elementType: 'labels.text.fill',
                        stylers: [{color: '#6b9a76'}]
                    },
                    {
                        featureType: 'road',
                        elementType: 'geometry',
                        stylers: [{color: '#38414e'}]
                    },
                    {
                        featureType: 'road',
                        elementType: 'geometry.stroke',
                        stylers: [{color: '#212a37'}]
                    },
                    {
                        featureType: 'road',
                        elementType: 'labels.text.fill',
                        stylers: [{color: '#9ca5b3'}]
                    },
                    {
                        featureType: 'road.highway',
                        elementType: 'geometry',
                        stylers: [{color: '#746855'}]
                    },
                    {
                        featureType: 'road.highway',
                        elementType: 'geometry.stroke',
                        stylers: [{color: '#1f2835'}]
                    },
                    {
                        featureType: 'road.highway',
                        elementType: 'labels.text.fill',
                        stylers: [{color: '#f3d19c'}]
                    },
                    {
                        featureType: 'transit',
                        elementType: 'geometry',
                        stylers: [{color: '#2f3948'}]
                    },
                    {
                        featureType: 'transit.station',
                        elementType: 'labels.text.fill',
                        stylers: [{color: '#d59563'}]
                    },
                    {
                        featureType: 'water',
                        elementType: 'geometry',
                        stylers: [{color: '#17263c'}]
                    },
                    {
                        featureType: 'water',
                        elementType: 'labels.text.fill',
                        stylers: [{color: '#515c6d'}]
                    },
                    {
                        featureType: 'water',
                        elementType: 'labels.text.stroke',
                        stylers: [{color: '#17263c'}]
                    }
                ]
            }
            var mapOptions = {
                zoom:12,
                center: { lat: 28.624364, lng: 77.208289 },
                styles: style
            }
            map = new google.maps.Map(document.getElementById('map'), mapOptions);
            directionsRenderer.setMap(map);

            var neworigin = document.getElementById('new-origin');
            var newstart = document.getElementById('new-start');
            var autocomplete1 = new google.maps.places.Autocomplete(neworigin);
                autocomplete1.setFields(
                    ['address_components', 'geometry', 'name']);


            autocomplete1.addListener('place_changed', function(){
                var place = autocomplete1.getPlace();
                if(!place.geometry){
                    window.alert("No details available for input: " + place.name);
                    return;
                }
            })

            var autocomplete2 = new google.maps.places.Autocomplete(newstart);
                autocomplete2.setFields(
                    ['address_components', 'geometry', 'name']);


            autocomplete2.addListener('place_changed', function(){
                var place = autocomplete2.getPlace();
                if(!place.geometry){
                    window.alert("No details available for input: " + place.name);
                    return;
                }
            })

            directionsRenderer.setPanel(document.getElementById('panel'));
            getLocation();
            geocoder = new google.maps.Geocoder;
        }

        function newOrigin(){
            start = document.getElementById('new-origin').value;
            $('#changeOriginModal').modal('hide');
            calculateAndDisplayRoute(directionsService, directionsRenderer);
        }

        function showPanel(){
            document.getElementById('panelOut').style.display = "block";
        }

        function closePanel(){
            document.getElementById('panelOut').style.display = "none";
        }

        function seeEvent(){
            $('#seeEventModal').modal('show');
        }

        function calculateAndDisplayRoute(directionsService, directionsRenderer) {
            directionsService.route(
                {
                    origin: {query: start},
                    destination: {query: end},
                    travelMode: mode, //DRIVING, WALKING, BICYCLING, TRANSIT
                    provideRouteAlternatives: false,
                    transitOptions: {
                        modes: ['BUS', 'RAIL', 'SUBWAY', 'TRAIN', 'TRAM']
                    }
                },
                function(response, status) {
                    if (status === 'OK') {
                        document.getElementById('stats-box').style.display = "block";
                        var distance = response.routes[0].legs[0].distance.text;
                        var time = response.routes[0].legs[0].duration;
                        var d=new Date();
                        var curTime = parseInt(d.getHours())*60+parseInt(d.getMinutes());
                        var dd = String(d.getDate()).padStart(2, '0');
                        var mm = String(d.getMonth() + 1).padStart(2, '0');
                        var yyyy = d.getFullYear();
                        today = yyyy + '-' + mm + '-' + dd;

                        //Departure Time calulation
                        var meetingStart=meetingStartTime.split(":");
                        var mins= parseInt(meetingStart[0])*60 + parseInt(meetingStart[1]);
                        mins=mins-parseInt(time.value/60);
                        var late=parseInt(curTime-mins);
                        if(mins<curTime&&meetingStartDate===today){
                            if(late<11){
                                console.log("you are "+late+" mins late for meeting");
                                $(function(){
                                    $("#cannotReach").toast('show');
                                })
                                document.getElementById('toast-message').textContent = "You are " + late + " mins late for meeting";


                            }

                            else if(late>10){
                                console.log("you cannot reach at your meeting");
                                $(function(){
                                    $("#cannotReach").toast('show');
                                })
                                document.getElementById('toast-message').textContent = "You cannot reach at your meeting";


                            }
                        }
                        else{
                          var departureTime =parseInt(mins/60)+":"+((mins%60 < 10) ? ("0" + mins%60) : mins%60);
                          console.log(departureTime);
                          document.getElementById('departure-time').style.display = "block";
                          document.getElementById('departure-time').textContent = "You can depart at " + departureTime + " on " + meetingStartDate;
                        }

                        //Calculate Free Time
                        if(meetingStartDate===today){
                            var freeTime =mins-curTime;
                            if(freeTime>0){
                                freeTime=parseInt(freeTime/60)+" hrs "+freeTime%60+" mins";
                                console.log(freeTime);
                                document.getElementById('free-time').style.display = "block";
                                document.getElementById('free-time').textContent = "You can spend " + freeTime + " before meeting" ;
                            }

                        }



                        document.getElementById('time').textContent = time.text;
                        document.getElementById('distance').textContent = '(' + distance + ')';
                        directionsRenderer.setDirections(response);
                    } else {
                        if(status == "ZERO_RESULTS"){
                            //alert('No route found for this mode...')
                            document.getElementById('time').textContent = "No route found.";
                            document.getElementById('distance').textContent = "";
                        }
                        //window.alert('Directions request failed due to ' + status);
                    }
                });
        }

        function getLocation(){
            if(navigator.geolocation){
                navigator.geolocation.getCurrentPosition(showPosition, showError);
            }
            else{
                alert("Geolocation is not supported here")
            }
        }

        function showPosition(position){
            var input = position.coords.latitude + "," + position.coords.longitude;
            var latlngStr = input.split(',', 2);
            var latlng = {lat: parseFloat(latlngStr[0]), lng: parseFloat(latlngStr[1])};
            geocoder.geocode({'location': latlng}, function(results, status) {
                if (status === 'OK') {
                    if (results[0]) {
                        start = results[0].formatted_address;
                        //weather work -----------------------------------------------------------------------
                        let url = 'https://api.openweathermap.org/data/2.5/weather?';
                        let key = '95f4556ffa70028d2fc2375e75e0f174';
                        let finalUrl = url + "lat=" + position.coords.latitude + "&lon=" + position.coords.longitude + '&units=metric&appid=' + key;
                        axios.get(finalUrl)
                          .then(response =>{
                            console.log(response)
                            document.getElementById('weather-temp').innerHTML = response.data.main.temp + '&deg; c';
                            let imgLink = 'https://openweathermap.org/img/wn/' + response.data.weather[0].icon + '.png';
                            document.getElementById('weather-image').setAttribute("src", imgLink);
                            document.getElementById('weather-location').textContent = response.data.name;
                            document.getElementById('weather-report').textContent = response.data.weather[0].description;
                            document.getElementById('temp-min').innerHTML = 'Min: ' + response.data.main.temp_min + '&deg; c';
                            document.getElementById('temp-max').innerHTML = 'Max: ' + response.data.main.temp_max + '&deg; c';

                            let months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
                            let today = new Date();
                            let date = today.getDate();
                            let month = today.getMonth();
                            let year = today.getFullYear();
                            document.getElementById('weather-date').textContent = 'Today, ' + date + ' ' + months[month] + ', ' + year;
                          })
                          .catch(err =>{
                            console.log(err);
                          })

                        var hourURL = 'https://api.openweathermap.org/data/2.5/forecast?' + 'lat=' + position.coords.latitude + '&lon=' + position.coords.longitude + '&units=metric&appid=' + key;
                        axios.get(hourURL)
                          .then(response =>{
                            console.log(response.data.list)
                            let weathers = response.data.list;
                            for(let i = 0; i < 4; i++){
                              let id = 'temp' + (i+1);
                              let dt_txt = weathers[i].dt_txt;
                              dt_txt = dt_txt.split(" ");
                              let time = dt_txt[1];
                              let date = dt_txt[0];
                              let imglink = 'https://openweathermap.org/img/wn/' + weathers[i].weather[0].icon + '.png';
                              document.getElementById(id).innerHTML = `
                                  <img src = ${imglink} />
                                  <span class='d-block'>${weathers[i].main.temp} &deg; c</span>
                                  <span class='d-block'>${time[0]}${time[1]}${time[2]}${time[3]}${time[4]} hrs</span>
                                `;
                            }
                          })
                          .catch(err =>{
                            console.log(err)
                          })

                        //getting current event info
                        axios.post(window.location)
                            .then(response =>{
                                if(response.data.success){
                                    meetingStartTime=response.data.event.meetingStartTime;
                                    meetingStartDate=response.data.event.meetingDate;
                                    end = response.data.event.location;

                                    //setting up see event details
                                    document.getElementById('event-name').textContent = response.data.event.event;
                                    document.getElementById('event-date').textContent = response.data.event.meetingDate;
                                    document.getElementById('event-time').textContent = response.data.event.meetingStartTime + ' to ' + response.data.event.meetingEndTime;
                                    document.getElementById('event-location').textContent = response.data.event.location;


                                    calculateAndDisplayRoute(directionsService, directionsRenderer);
                                }
                                else{
                                    console.log(response.data.message)
                                }
                            })
                            .catch(err =>{
                                console.log(err)
                            })

                    } else {
                        window.alert('No results found');
                    }
                } else {
                    window.alert('Geocoder failed due to: ' + status);
                }
            });
        }

        function showError(error){
            switch(error.code){
                case error.PERMISSION_DENIED:
                    console.log("User denied request for location")
                    break;
                case error.POSITION_UNAVAILABLE:
                    console.log("Location information is unavailable")
                    break;
                case error.TIMEOUT:
                    console.log("Request to get location timed out")
                    break;
                case error.UNKNOWN_ERROR:
                    console.log("Unknown error occurred")
                    break;
            }
        }

        function changeMode(newMode){
            mode = newMode;
            calculateAndDisplayRoute(directionsService, directionsRenderer);
        }
    </script>
</body>

</html>
