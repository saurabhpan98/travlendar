<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
    <link rel="icon" type="image/png" href="./images/logo-travel.png"/>
    <title>Travlendar</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.0/css/bootstrap.min.css" integrity="sha384-9aIt2nRpC12Uk9gS9baDl411NQApFmC26EwAOH8WgZl5MYYxFfc+NcPb1dKGj7Sk" crossorigin="anonymous">
    <link rel="stylesheet" href="assets/css/Navigation-Clean.css">
    <link rel="stylesheet" href="assets/css/styles.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/axios/0.19.2/axios.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400&display=swap" rel="stylesheet">

    <link rel="manifest" href="../manifest.json">
    <link rel="apple-touch-icon" href="/images/pwa-images/icon-96x96.png">
    <meta name="apple-mobile-web-app-status-bar" content="white">
    <meta name="theme-color" content="white">

    <style>
        body{
            font-family: 'Roboto', sans-serif;
        }
        #firstIcon{
            animation: updown 2s ease infinite;
        }
        #secondIcon{
            animation: updown 2s -1.2s ease infinite;
        }
        #thirdIcon{
            animation: updown 2s -1.7s ease infinite;
        }
        @keyframes updown {
            0% { transform: translate(-32px, -92px); }
            50% { transform: translate(-32px, -110px); }
            100% { transform: translate(-32px, -92px); }
        }
        #main-cloud{
            animation: cloudleftright 3s ease-in-out alternate infinite;
        }
        @keyframes cloudleftright{
            from { transform: translateX(-7%); transform: rotateY(-20deg); }
            to { transform: translateX(-2%); transform: rotateY(-10deg); }
        }

        #travel-time-grass{
            transform-box: fill-box;
            transform-origin: bottom;
            animation: grass 3s ease-in-out alternate infinite;
        }
        #travel-time-grass-2{
            transform-box: fill-box;
            transform-origin: bottom;
            animation: grass 3s -2s ease-in-out alternate infinite;
        }
        @keyframes grass{
            0% { transform: translate(-100px, -50px) rotate(-7deg); }
            100% {transform: translate(-100px, -50px) rotate(7deg);  }
        }
        #travel-time-min-hand{
            transform-box: fill-box;
            transform-origin: bottom;
            animation: clock 10s linear infinite;
        }
        @keyframes clock{
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        #conflict-question-mark{
            transform-box: fill-box;
            transform-origin: bottom;
            animation: questionmark 3s ease-in-out alternate infinite;
        }
        @keyframes questionmark{
            from { transform: translate(-47px, -52px) rotate(-10deg); }
            to { transform: translate(-47px, -52px) rotate(10deg); }
        }

        #directions-map-logo{
            transform-box: fill-box;
            transform-origin: bottom;
            animation: maplogo 2s ease-in-out alternate infinite;
        }
        @keyframes maplogo{
            from { transform: translate(-77px, -85px) rotate(-6deg); }
            to { transform: translate(-77px, -85px) rotate(6deg); }
        }

        #travel-circle{
            transform-box: fill-box;
            transform-origin: center;
            animation: scale_circle 1s ease-in-out alternate infinite;
        }
        @keyframes scale_circle{
            from { transform: scale(1); }
            to { transform: scale(1.3); }
        }
        #travel-car{
            transform-box: fill-box;
            transform-origin: center;
            animation: car 3s ease-in-out infinite;
        }
        @keyframes car{
            from { transform: translate(-156px, -153px) scale(1); }
            to { transform: translate(-156px, -120px) scale(1.2); }
        }

        .faq-bg{
            background-image: url('/images/faq.svg');
            background-repeat: no-repeat;
            background-position: top left;
            background-size: 60%;
            background-position-y: 30px;
        }
        .signup-login-bg{
            background-image: url('/images/skateboard.svg');
            background-position: bottom right;
            background-repeat: no-repeat;
            background-size: 70%;
        }

        .footer{
            background-image: url('/images/footer-background.jpg');
            background-position: top left;
            background-repeat: repeat;
            background-size: 100%;
        }

        .footer .contact-form input, .footer .contact-form textarea{
            background: rgba(0,0,0,0);
        }
    </style>
</head>

<body>
    <nav class="navbar navbar-light navbar-expand-md shadow-sm">
        <div class="container-fluid">
            <a class="navbar-brand d-flex" href="/">
                <img src="./images/logo-travel.png" class="mr-2" height="30px" width="30px" />
                <span style="">Travlendar</span>
            </a>
            <button data-toggle="collapse" class="navbar-toggler" data-target="#navcol-1"><span class="sr-only">Toggle navigation</span><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse"
                id="navcol-1">
                <ul class="nav navbar-nav ml-auto">
                    <li class="nav-item px-2" role="presentation" href="#"><a class="nav-link active" href="/">Home</a></li>
                    <li class="nav-item px-2" role="presentation"><a class="nav-link" href="/about">About</a></li>
                    <li class="nav-item px-2" role="presentation"><a class="nav-link" href="/team">Team</a></li>
                    <% if(user) { %>
                        <li class="nav-item px-2" role="presentation" id="profile"><a class="nav-link" href="/profile">Profile</a></li>
                    <% } else { %>
                        <li class="nav-item px-2" role="presentation" id="login"><a class="nav-link" href="/login">Login</a></li>
                        <li class="nav-item px-2" role="presentation" id="signup"><a class="nav-link" href="/signup">Signup</a></li>
                    <% } %>
                </ul>
            </div>
        </div>
    </nav>
