<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
    <link rel="icon" type="image/png" href="./images/logo-travel.png"/>
    <title>Travlendar</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.0/css/bootstrap.min.css" integrity="sha384-9aIt2nRpC12Uk9gS9baDl411NQApFmC26EwAOH8WgZl5MYYxFfc+NcPb1dKGj7Sk" crossorigin="anonymous">
    <link rel="stylesheet" href="/assets/fonts/material-icons.min.css">
    <link rel="stylesheet" href="assets/css/Navigation-Clean.css">
    <link rel="stylesheet" href="assets/css/styles.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/axios/0.19.2/axios.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400&display=swap" rel="stylesheet">
    <style>
        body{
            font-family: 'Roboto', sans-serif;
        }
    </style>
</head>

<body>
    <nav class="navbar navbar-light navbar-expand-md shadow-sm">
        <div class="container-fluid">
            <a class="navbar-brand d-flex" href="/">
                <img src="./images/logo-travel.png" class="mr-2" height="30px" width="30px" />
                <span style="">Travlendar</span>
            </a>
            <button data-toggle="collapse" class="navbar-toggler" data-target="#navcol-1"><span class="sr-only">Toggle navigation</span><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse"
                id="navcol-1">
                <ul class="nav navbar-nav ml-auto">
                    <li class="nav-item px-2" role="presentation" href="#"><a class="nav-link active" href="/">Home</a></li>
                    <li class="nav-item px-2" role="presentation"><a class="nav-link" href="/about">About</a></li>
                    <li class="nav-item px-2" role="presentation"><a class="nav-link" href="/team">Team</a></li>
                    <% if(user) { %>
                        <li class="nav-item px-2" role="presentation" id="profile"><a class="nav-link" href="/profile">Profile</a></li>
                    <% } else { %>
                        <li class="nav-item px-2" role="presentation" id="login"><a class="nav-link" href="/login">Login</a></li>
                        <li class="nav-item px-2" role="presentation" id="signup"><a class="nav-link" href="/signup">Signup</a></li>
                    <% } %>
                </ul>
            </div>
        </div>
    </nav>
    <div class="container py-4">
        <div class="section">
            <div class="row">
                <div class="col-sm-6">
                    <h1 class="mt-5 display-4">Travlendar <img src="./images/logo-travel.png" style="height: 1.2em; width: 1em;" /></h1>
                    <h3 id="tagline">Your <span class="text-primary">travel guide<span></h3>
                    <p class="lead mt-5">Looking for someone to map your 
                        events and work like your travel guide! Here's 
                        the Travlendar you can trust upon.
                    </p>
                    <div class="main-buttons d-flex mt-5">
                        <a href="/about" class="btn btn-outline-warning text-decoration-none w-100 mr-3">
                            Know more
                        </a>
                        <a href="/login" class="btn btn-outline-primary text-decoration-none w-100">
                            Get started
                        </a>
                    </div>
                </div>
                <div class="col-sm-1"></div>
                <div class="col-sm-5">
                    <img src="/images/main-image-1.svg" class="mt-5" height="100%" width="100%">
                </div>
            </div>
        </div>  
    </div>
    <script src="https://code.jquery.com/jquery-3.5.1.min.js" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.0/js/bootstrap.min.js" integrity="sha384-OgVRvuATP1z7JjHLkuOU7Xw704+h835Lr+6QL9UvYjZE3Ipu6Tp75j7Bh/kR0JKI" crossorigin="anonymous"></script>
    <script>
        let tagline = document.getElementById('tagline');
        let tag = "Your travel guide";
        setInterval(function(){
            if(tag == "Your travel guide"){
                tagline.innerHTML = 'Your <span class="text-primary">event handler<span>';
                tag = "Your event handler";
            }
            else{
                tagline.innerHTML = 'Your <span class="text-primary">travel guide<span>';
                tag = "Your travel guide";
            }
        }, 3000);
    </script>
</body>

</html>