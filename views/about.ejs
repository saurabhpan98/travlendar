<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
    <link rel="icon" type="image/png" href="./images/logo-travel.png"/>
    <title>Travlendar / About</title>
    <link rel="stylesheet" href="assets/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="assets/fonts/material-icons.min.css">
    <link rel="stylesheet" href="assets/css/Navigation-Clean.css">
    <link rel="stylesheet" href="assets/css/styles.css">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400&display=swap" rel="stylesheet">
    <style>
        body{
            font-family: 'Roboto', sans-serif;
        }
    </style>
</head>

<body>
    <nav class="navbar navbar-light navbar-expand-md shadow-sm">
        <div class="container-fluid">
            <a class="navbar-brand d-flex" href="/">
                <img src="./images/logo-travel.png" class="mr-2" height="30px" width="30px" />
                <span style="">Travlendar</span>
            </a>
            <button data-toggle="collapse" class="navbar-toggler" data-target="#navcol-1"><span class="sr-only">Toggle navigation</span><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse"
                id="navcol-1">
                <ul class="nav navbar-nav ml-auto">
                    <li class="nav-item px-2" role="presentation" href="#"><a class="nav-link" href="/">Home</a></li>
                    <li class="nav-item px-2" role="presentation"><a class="nav-link active" href="/about">About</a></li>
                    <li class="nav-item px-2" role="presentation"><a class="nav-link" href="/team">Team</a></li>
                    <% if(user) { %>
                        <li class="nav-item px-2" role="presentation" id="profile"><a class="nav-link" href="/profile">Profile</a></li>
                    <% } else { %>
                        <li class="nav-item px-2" role="presentation" id="login"><a class="nav-link" href="/login">Login</a></li>
                    <li class="nav-item px-2" role="presentation" id="signup"><a class="nav-link" href="/signup">Signup</a></li>
                    <% } %>
                </ul>
            </div>
        </div>
    </nav>
    <div class="container py-4">
        <h1 class="text-center mt-5">About Us</h1>
    </div>
    <script src="assets/js/jquery.min.js"></script>
    <script src="assets/bootstrap/js/bootstrap.min.js"></script>
</body>

</html>