<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
    <link rel="icon" type="image/png" href="./images/travlendar-icons-1.png"/>
    <title>Travlendar / 
        <% if(user.name) { %>
            <%= user.name %>
        <% } else if(user.googleId != "") { %>
            <%= user.name %>
        <% } else { %>
            <%= user.username %>
        <% } %>
    </title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.0/css/bootstrap.min.css" integrity="sha384-9aIt2nRpC12Uk9gS9baDl411NQApFmC26EwAOH8WgZl5MYYxFfc+NcPb1dKGj7Sk" crossorigin="anonymous">
    <link rel="stylesheet" href="assets/fonts/material-icons.min.css">
    <link rel="stylesheet" href="assets/css/Navigation-Clean.css">
    <link rel="stylesheet" href="assets/css/styles.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/axios/0.19.2/axios.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400&display=swap" rel="stylesheet">
    <style>
        body{
            font-family: 'Roboto', sans-serif;
        }
    </style>
</head>

<body>
    <nav class="navbar navbar-light navbar-expand-md shadow-sm">
        <div class="container-fluid">
            <a class="navbar-brand d-flex" href="/profile">
                <% if(user.googleId != "") { %>
                    <img src = <%= user.thumbnail %> width="30" height="30" class="d-inline-block align-top mr-1" />
                    <%= user.name %>
                <% } else if(user.githubId != "") { %>
                    <img src = <%= user.thumbnail %> width="30" height="30" class="d-inline-block align-top mr-1" />
                    <%= user.username %>
                <% } else { %>
                    <%= user.name %>
                <% } %>
            </a>
            <button data-toggle="collapse" class="navbar-toggler" data-target="#navcol-1"><span class="sr-only">Toggle navigation</span><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse"
                id="navcol-1">
                <ul class="nav navbar-nav ml-auto">
                    <li class="nav-item px-2" role="presentation" href="#"><a class="nav-link" href="/">Home</a></li>
                    <li class="nav-item px-2" role="presentation" href="#"><a class="nav-link" href="/profile">Events</a></li>
                    <li class="nav-item px-2" role="presentation" href="#"><a class="nav-link" href="/settings">Settings</a></li>
                    <li class="nav-item px-2" role="presentation" href="#"><a class="nav-link" href="/logout">Logout</a></li>
                </ul>
            </div>
        </div>
    </nav>
    <div class="container py-5">
        <a class="btn btn-outline-primary ml-2 d-inline-flex" href="/new-event">
            <i class="material-icons">edit</i>
            <span>Add new event</span>
        </a>
        <a class="btn btn-outline-warning ml-2 d-inline-flex" href="/timeline">
            <i class="material-icons">location_on</i>
            <span>Today's timeline</span>
        </a>
        <h1 class="my-4">Coming events</h1>
        <div class="coming-events row">
        </div>
        
        <h1 class="my-4 mt-5">Past events</h1>
        <div class="past-events row">
            
        </div>
    </div>

    <div class="modal fade" id="deleteModal" tabindex="-1" role="dialog" aria-labelledby="deleteModalCenterTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm" role="document">
          <div class="modal-content">
            <div class="modal-body">
                <h5 class="modal-title mb-2 font-weight-bold" id="deleteModalLongTitle">Delete event!</h5>  
                <p>Are you sure to delete this event?</p>
                <button type="button" class="btn btn-primary float-right" onclick = "deleteEvent()">Delete</button>
                <button type="button" class="btn btn-light mr-2 float-right" data-dismiss="modal">Cancel</button>
            </div>
          </div>
        </div>
      </div>
    <script src="https://code.jquery.com/jquery-3.5.1.min.js" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.0/js/bootstrap.min.js" integrity="sha384-OgVRvuATP1z7JjHLkuOU7Xw704+h835Lr+6QL9UvYjZE3Ipu6Tp75j7Bh/kR0JKI" crossorigin="anonymous"></script>
    <script src = "/scripts/profile-script.js"></script>
    <script>
        let deleteId;
        function showDeleteModal(id){
            //console.log(deleteId)
            deleteId = id; 
            $('#deleteModal').modal('show');
        }

        function deleteEvent(){
            axios.post('/delete-event', {deleteId: deleteId})
                .then(response =>{
                    if(response.data.success)
                        window.location.href = "/profile";
                    else
                        console.log(response.data.message);
                })
                .catch(err =>{
                    console.log(err)
                })
        }
        
        axios.get('/myevents')
            .then(response =>{
                if(response.data.success){
                    console.log(response)
                    let comingEvents = document.getElementsByClassName('coming-events')[0];
                    let pastEvents = document.getElementsByClassName('past-events')[0];

                    let events = response.data.events;
                    var today = new Date();
                    var date = today.getFullYear()+'-'+(today.getMonth()+1)+'-'+today.getDate();
                    var time = today.getHours() + ":" + today.getMinutes() 
                    var d = new Date(date + " " + time);   
                    d.setHours(d.getHours() + 5);
                    d.setMinutes(d.getMinutes() + 30);
                    var isodate = d.toISOString(); 
                    
                    let upComingCount = 0, pastCount = 0;
                    
                    for(let i = 0; i < events.length; i++){
                        let event = events[i];
                        if(event.meetingStartDate>=isodate){
                            let date = event.meetingStartDate.split("T");
                            let item = `<div class="col-sm-4 my-2 h-100"">
                                            <div class="pl-1 bg-primary shadow-sm rounded">
                                                <div class="p-2 pl-3 bg-white rounded">
                                                    <h4 class="mb-3">${event.event}</h4>
                                                    <span class="d-block"><strong>Meeting on:</strong> ${date[0]}</span>
                                                    <span class="d-block"><strong>Meeting time:</strong> ${event.meetingStartTime} to ${event.meetingEndTime}</span>
                                                    <span class="d-block mt-3"><strong>Location:</strong> ${event.location}</span>
                                                    <div class="w-100 d-flex pb-2">
                                                        <a class="text-center text-primary w-100 material-icons mt-3 mx-2 text-decoration-none" href="/profile/${event._id}" data-toggle="tooltip" data-placement="bottom" title="View event">search</a>
                                                        <a class="text-center text-dark w-100 material-icons mt-3 mx-2 text-decoration-none" href="#" data-toggle="tooltip" data-placement="bottom" title="Edit event">edit</a>
                                                        <a class="text-center text-danger w-100 material-icons mt-3 mx-2 text-decoration-none" href="#" data-toggle="tooltip" data-placement="bottom" title="Delete event" onclick="showDeleteModal('${event._id}')">delete</a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>`;
                            comingEvents.innerHTML += item; 
                            upComingCount += 1;
                        }
                        else{
                            let date = event.meetingStartDate.split("T");
                            let item = `<div class="col-sm-4 my-2">
                                            <div class="pl-1 bg-danger shadow-sm rounded">
                                                <div class="p-2 pl-3 bg-white rounded">
                                                    <h4 class="mb-3">${event.event}</h4>
                                                    <span class="d-block"><strong>Meeting on:</strong> ${date[0]}</span>
                                                    <span class="d-block"><strong>Meeting time:</strong> ${event.meetingStartTime} to ${event.meetingEndTime}</span>
                                                    <span class="d-block mt-3"><strong>Location:</strong> ${event.location}</span>
                                                    <div class="w-100 d-flex pb-2">
                                                        <a class="text-center text-primary w-100 material-icons mt-3 mx-2 text-decoration-none" href="/profile/${event._id}" data-toggle="tooltip" data-placement="bottom" title="View event">search</a>
                                                        <a class="text-center text-dark w-100 material-icons mt-3 mx-2 text-decoration-none" href="#" data-toggle="tooltip" data-placement="bottom" title="Edit event">edit</a>
                                                        <a class="text-center text-danger w-100 material-icons mt-3 mx-2 text-decoration-none" href="#" data-toggle="tooltip" data-placement="bottom" title="Delete event" onclick="showDeleteModal('${event._id}')">delete</a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>`;
                            pastEvents.innerHTML += item; 
                            pastCount += 1;
                        }
                    }

                    //do here
                    if(upComingCount == 0){
                        comingEvents.innerHTML += '<p class="lead pl-3">No upcoming events present</p>';
                    }
                    if(pastCount == 0){
                        pastEvents.innerHTML += '<p class="lead pl-3">No past events present</p>';
                    }
                }
                else{
                    console.log(response.data.message)
                }
            })
            .catch(err =>{
                console.log(err);
            })
    </script>
</body>

</html>