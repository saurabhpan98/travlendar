<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
    <link rel="icon" type="image/png" href="./images/travlendar-icons-1.png"/>
    <title>Travlendar / <%= user.name %></title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.0/css/bootstrap.min.css" integrity="sha384-9aIt2nRpC12Uk9gS9baDl411NQApFmC26EwAOH8WgZl5MYYxFfc+NcPb1dKGj7Sk" crossorigin="anonymous">
    <link rel="stylesheet" href="assets/fonts/material-icons.min.css">
    <link rel="stylesheet" href="assets/css/Navigation-Clean.css">
    <link rel="stylesheet" href="assets/css/styles.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/axios/0.19.2/axios.min.js"></script>
</head>

<body>
    <nav class="navbar navbar-light navbar-expand-md shadow-sm">
        <div class="container-fluid">
            <a class="navbar-brand" href="/profile">
                <%= user.name %>
            </a>
            <button data-toggle="collapse" class="navbar-toggler" data-target="#navcol-1"><span class="sr-only">Toggle navigation</span><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse"
                id="navcol-1">
                <ul class="nav navbar-nav ml-auto">
                    <li class="nav-item px-2" role="presentation" href="#"><a class="nav-link" href="/">Home</a></li>
                    <li class="nav-item px-2" role="presentation" href="#"><a class="nav-link" href="/profile">Events</a></li>
                    <li class="nav-item px-2" role="presentation" href="#"><a class="nav-link" href="/settings">Settings</a></li>
                    <li class="nav-item px-2" role="presentation" href="#"><a class="nav-link" href="/logout">Logout</a></li>
                </ul>
            </div>
        </div>
    </nav>
    <div class="container py-5"><a class="btn btn-outline-primary" href="/new-event">Add new event&nbsp;</a>
        <div class="row mb-4">
            <div class="col-lg-5 pt-4">
                <h1 class="mb-4">Coming events</h1>
                <div class="coming-events">
                </div>
            </div>
            <div class="col-lg-2"></div>
            <div class="col-lg-5 pt-4">
                <h1 class="mb-4">Past events</h1>
                <div class="past-events">
                    
                </div>
            </div>
        </div>
    </div>
    <script src="https://code.jquery.com/jquery-3.5.1.min.js" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.0/js/bootstrap.min.js" integrity="sha384-OgVRvuATP1z7JjHLkuOU7Xw704+h835Lr+6QL9UvYjZE3Ipu6Tp75j7Bh/kR0JKI" crossorigin="anonymous"></script>
    <script src = "/scripts/profile-script.js"></script>
    <script>
        
        axios.get('/myevents')
            .then(response =>{
                if(response.data.success){
                    console.log(response)
                    let comingEvents = document.getElementsByClassName('coming-events')[0];
                    let pastEvents = document.getElementsByClassName('past-events')[0];

                    let events = response.data.events;
                    for(let i = 0; i < events.length; i++){
                        let event = events[i];
                        let date = event.meetingStartDate.split("T");
                        let item = `<div class="p-3 shadow-sm rounded my-3">
                                        <h4>${event.event}</h4>
                                        <span class="d-block"><strong>Meeting on:</strong> ${date[0]}</span>
                                        <span class="d-block"><strong>Meeting time:</strong> ${event.meetingStartTime} to ${event.meetingEndTime}</span>
                                        <span class="d-block mt-3"><strong>Location:</strong> ${event.location}</span>
                                        <div class="w-100 d-flex">
                                            <a class="btn btn-light btn-block text-center material-icons mt-3 mx-2 text-decoration-none" href="#" data-toggle="tooltip" data-placement="bottom" title="View event">search</a>
                                            <a class="btn btn-light btn-block text-center material-icons mt-3 mx-2 text-decoration-none" href="#" data-toggle="tooltip" data-placement="bottom" title="Edit event">edit</a>
                                            <a class="btn btn-light btn-block text-center material-icons mt-3 mx-2 text-decoration-none" href="#" data-toggle="tooltip" data-placement="bottom" title="Delete event">delete</a>
                                        </div>
                                    </div>`;
                        comingEvents.innerHTML += item; 
                    }
                }
                else{
                    console.log(response.data.message)
                }
            })
            .catch(err =>{
                console.log(err);
            })
    </script>
</body>

</html>