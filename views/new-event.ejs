<!DOCTYPE html>
<html>
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
        <link rel="icon" type="image/png" href="./images/travlendar-icons-1.png"/>
        <title>Travlendar / New event</title>
        <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.0/css/bootstrap.min.css" integrity="sha384-9aIt2nRpC12Uk9gS9baDl411NQApFmC26EwAOH8WgZl5MYYxFfc+NcPb1dKGj7Sk" crossorigin="anonymous">
        <link rel="stylesheet" href="assets/fonts/material-icons.min.css">
        <link rel="stylesheet" href="assets/css/Navigation-Clean.css">
        <link rel="stylesheet" href="assets/css/styles.css">
        
        <script src="https://cdnjs.cloudflare.com/ajax/libs/axios/0.19.2/axios.min.js"></script>
        <style>
            #event_form{
                max-width: 600px;
                margin: 0 auto;
            }
        </style>

    </head>

    <body>
        <nav class="navbar navbar-light navbar-expand-md shadow-sm">
            <div class="container-fluid">
                <a class="navbar-brand" href="/profile">
                    <%= user.name %>
                </a>
                <button data-toggle="collapse" class="navbar-toggler" data-target="#navcol-1"><span class="sr-only">Toggle navigation</span><span class="navbar-toggler-icon"></span></button>
                <div class="collapse navbar-collapse"
                    id="navcol-1">
                    <ul class="nav navbar-nav ml-auto">
                        <li class="nav-item px-2" role="presentation" href="#"><a class="nav-link" href="/">Home</a></li>
                        <li class="nav-item px-2" role="presentation" href="#"><a class="nav-link" href="/profile">Events</a></li>
                        <li class="nav-item px-2" role="presentation" href="#"><a class="nav-link" href="/settings">Settings</a></li>
                        <li class="nav-item px-2" role="presentation" href="#"><a class="nav-link" href="/logout">Logout</a></li>
                    </ul>
                </div>
            </div>
        </nav>
        <div class="container pb-5 mb-5">
            <form id = "event_form" onsubmit="formSubmit()">
                <h2 class="mt-5 mb-4">New event</h2>
                <div class="alert-box mb-2" id="alert-box">
        
                </div>
                <input type="text" class="text-center form-control mb-3" placeholder="Event name" name="event" id="event" required />
                <div class="row mb-3">
                    <div class="col-sm-3 my-2"><label class="col-form-label">From</label></div>
                    <div class="col-sm-5"><input class="form-control my-2" type="date" name = "meetingStartDate" required /></div>
                    <div class="col-sm-4 my-2"><input class="form-control" type="time" name = "meetingStartTime" required /></div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-3 my-2"><label class="col-form-label">Until</label></div>
                    <div class="col-sm-5 my-2"><input class="form-control" type="date" name = "meetingEndDate" required /></div>
                    <div class="col-sm-4 my-2"><input class="form-control" type="time" name = "meetingEndTime" required /></div>
                </div>
                <div class="row mb-3">
                    <div class="col-lg-3 my-2"><label class="col-form-label">Event location</label></div>
                    <div class="col-lg-9 d-flex my-2"><i class="material-icons mt-2 mr-2 text-danger">place</i><input class="form-control" type="text" placeholder="Event location" name="location" id="location" required /></div>
                </div>
                <textarea class="form-control mb-4 text-center" name="extraInfo" placeholder="Add extra note (optional)" id="extraInfo"></textarea>
                <div class="row">
                    <div class="col-6">
                        <a href="/profile" class="btn btn-outline-danger btn-block" type="button">Cancel</a>
                    </div>
                    <div class="col-6">
                        <button class="btn btn-primary btn-block" type="submit" id="event_submit">Save event</button>
                    </div>
                </div>
            </form>
        </div>

        <div class="modal" id="conflictModal" tabindex="-1" role="dialog" aria-labelledby="conflictModalLabel" aria-hidden="true">
            <div class="modal-dialog" role="document">
              <div class="modal-content">
                <div class="modal-header">
                  <h5 class="modal-title" id="conflictModalLabel">Conflicting alert!!</h5>
                  <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                  </button>
                </div>
                <div class="modal-body">
                  <p>New event's timing are conflicting with these meetings. Please check and either delete these or change new one's timing.</p>
                  <div id="accordion">

                  </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-primary" data-dismiss="modal">Change timing</button>
                    <button type="button" class="btn btn-danger" onclick="deleteConflicts()">Delete all</button>
                </div>
              </div>
            </div>
          </div>

        <script src="https://code.jquery.com/jquery-3.5.1.min.js" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous"></script>
        <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.0/js/bootstrap.min.js" integrity="sha384-OgVRvuATP1z7JjHLkuOU7Xw704+h835Lr+6QL9UvYjZE3Ipu6Tp75j7Bh/kR0JKI" crossorigin="anonymous"></script>
        <script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyD4-QOWTvatTe_46i2XOI6tXUIx40hHVQY&libraries=places&callback=initMap" async defer></script>
        <script>
            function initMap(){

                var input = document.getElementById('location');

                var autocomplete = new google.maps.places.Autocomplete(input);
                autocomplete.setFields(
                    ['address_components', 'geometry', 'name']);
                

                autocomplete.addListener('place_changed', function(){
                    var place = autocomplete.getPlace();
                    console.log(place)
                    if(!place.geometry){
                        window.alert("No details available for input: " + place.name);
                        return; 
                    }
                })
            }
        </script>
        <script>
            var form = document.getElementById('event_form');
            let conflicts = [];

            function formSubmit(){
                event.preventDefault();
                let form = event.target;
                let newevent = {
                    event: form.event.value,
                    meetingStartDate: form.meetingStartDate.value,
                    meetingStartTime: form.meetingStartTime.value,
                    meetingEndTime: form.meetingEndTime.value,
                    location: form.location.value,
                    extraInfo: form.extraInfo.value 
                }
                document.getElementById('accordion').innerHTML = "";
                conflicts = [];
                document.getElementById('alert-box').innerHTML = "";
                axios.post("/new-event", newevent)
                    .then(response =>{
                        //console.log(response.data.conflictMeetings);
                        //alert(response.data.message);
                        if(response.data.message == "Event conflict"){
                            let conflictMeetings = response.data.conflictMeetings;
                            for(let i = 0; i < conflictMeetings.length; i++){
                                conflicts.push(conflictMeetings[i]._id);
                                let date = conflictMeetings[i].meetingStartDate.split("T");
                                var card = `<div class="card">
                                                <div class="card-header" id="heading${i}">
                                                <h5 class="mb-0 btn btn collapsed" data-toggle="collapse" data-target="#collapse${i}" aria-expanded="true" aria-controls="collapse${i}">
                                                    ${conflictMeetings[i].event}
                                                </h5>
                                                </div>

                                                <div id="collapse${i}" class="collapse" aria-labelledby="heading${i}" data-parent="#accordion">
                                                <div class="card-body">
                                                    <span class="d-block"><strong>Meeting on:</strong> ${date[0]}</span>
                                                    <span class="d-block"><strong>Meeting time:</strong> ${conflictMeetings[i].meetingStartTime} to ${conflictMeetings[i].meetingEndTime}</span>
                                                    <span class="d-block mt-3"><strong>Location:</strong> ${conflictMeetings[i].location}</span>
                                                </div>
                                                </div>
                                            </div>`;
                                document.getElementById('accordion').innerHTML += card; 
                            }
                            $(function(){
                                $('#conflictModal').modal('show');
                            })
                        }
                        else if(response.data.message == "Event formed"){
                            
                            let alert = '<div class="alert alert-success alert-dismissible fade show" role="alert"><strong>New event added.</strong> Go to events to check added event.<button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button></div>';
                            document.getElementById('alert-box').innerHTML += alert;
                            
                            form.event.value = null; 
                            form.meetingStartDate.value = null;
                            form.meetingEndDate.value = null; 
                            form.meetingStartTime.value = null; 
                            form.meetingEndTime.value = null; 
                            form.location.value = null; 
                            form.extraInfo.value = null; 
                        }
                        else{
                            alert(response.data.message);
                        }
                    })
                    .catch(err =>{
                        console.log(err)
                    })
            }

            function deleteConflicts(){
                //console.log(conflicts);
                let conflictEvents = {
                    conflicts: conflicts,
                    message: "Delete conflicts"
                };
                axios.post('/deleteconflicts', conflictEvents)
                    .then(response =>{
                        $(function(){
                            $('#conflictModal').modal('hide');
                        })
                        let alert = '<div class="alert alert-warning alert-dismissible fade show" role="alert"><strong>Conflicts deleted.</strong> Now you can add this event.<button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button></div>';
                        document.getElementById('alert-box').innerHTML += alert;
                    })
                    .catch(err =>{
                        $(function(){
                            $('#conflictModal').modal('hide');
                        })
                        console.log(err)
                    })
            }
        </script>
        <script src="scripts/new-event-script.js"></script>
    </body>

</html>